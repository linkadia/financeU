DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
FRONTEND_SIGNUP_URL=http://localhost:5173/signup
INTEGRATOR_WEBHOOK_SECRET=replace-with-shared-secret

# Local development defaults to SQLite. Keep this value while testing locally.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Production MySQL/RDS example. Enable only in hosting by setting DB_ENGINE=mysql.
# DB_ENGINE=mysql
# DB_NAME=finanu
# DB_USER=finanu_user
# DB_PASSWORD=change-me
# DB_HOST=finanu.xxxxxx.eu-west-1.rds.amazonaws.com
# DB_PORT=3306
# DB_CONN_MAX_AGE=60

# Production cache/throttling. Leave empty locally; set it in production when
# using multiple workers or instances so cache and DRF throttle counters are shared.
REDIS_URL=
DJANGO_REDIS_IGNORE_EXCEPTIONS=True

# Optional Gemini API key for RSS news enrichment and market data refresh.
# GOOGLE_API_KEY=change-me
# GEMINI_API_KEY=change-me

# Optional RSS news enrichment with LangChain/Gemini.
# NEWS_LLM_MODEL=gemini-3.1-flash-lite
# NEWS_MIN_PUBLISHED_AT=2026-06-01

# Optional market carousel refresh with LangChain/Gemini + Google Search grounding.
# MARKET_LLM_MODEL=gemini-3.5-flash
# MARKET_LLM_INPUT_USD_PER_1M=0
# MARKET_LLM_OUTPUT_USD_PER_1M=0
# MARKET_LLM_GOOGLE_SEARCH_USED_THIS_MONTH=0
