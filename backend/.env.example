DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False

# Local development defaults to SQLite. Keep this value while testing locally.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Production MySQL/RDS example. Enable only in hosting by setting DB_ENGINE=mysql.
# DB_ENGINE=mysql
# DB_NAME=finanu
# DB_USER=finanu_user
# DB_PASSWORD=change-me
# DB_HOST=finanu.xxxxxx.eu-west-1.rds.amazonaws.com
# DB_PORT=3306
# DB_CONN_MAX_AGE=60
